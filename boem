ui <- fluidPage(titlePanel("Galgje"),

  # bovenste rij
  fluidRow(
    column(3, numericInput("woordlengte", "Woordlengte:", value = 5, min = 3, max = 14)),
    column(10, actionButton("nieuw_spel", "Nieuw spel"))
  ),

  textOutput("debug_woord"),
  h2(textOutput("gewonnen_tekst"), style = "color: lightgreen;"),
  h2(textOutput("verloren_tekst"), style = "color: red;"),

  br(),

  div(style = "max-width: 480px; margin: 0 auto;",
      plotOutput("galg", width = "480px", height = "480px"),
      div(style = "text-align: center; font-size: 28px; letter-spacing: 8px; margin: 10px 0;",
          h3(textOutput("patroon_tekst"))
      ),
      uiOutput("toetsenbord")
  )
)

server <- function(input, output, session) {

  woord        <- reactiveVal("")
  patroon      <- reactiveVal(c())
  fout_letters <- reactiveVal(c())
  fouten       <- reactiveVal(0)
  spel_klaar   <- reactiveVal(FALSE)
  laatste_gok  <- reactiveVal(NULL)
  win_frame    <- reactiveVal(0)   
  dood_frame   <- reactiveVal(0)   

  # Timer voor dans-animati
  win_timer <- reactiveTimer(120)
  observeEvent(win_timer(), {
    if (spel_klaar() && is_gewonnen(patroon())) {
      win_frame((win_frame() + 1) %% 32)
    }
  })

  # Timer voor dood-animatie
  dood_timer <- reactiveTimer(80)
  observeEvent(dood_timer(), {
    if (spel_klaar() && !is_gewonnen(patroon())) {
      if (dood_frame() < 80) dood_frame(dood_frame() + 1)
    }
  })

  alle_letters <- c("q","w","e","r","t","y","u","i","o","p",
                    "a","s","d","f","g","h","j","k","l",
                    "z","x","c","v","b","n","m")

  observeEvent(input$nieuw_spel, {
    w <- kies(input$woordlengte)
    woord(w)
    patroon(maak_patroon(w))
    fout_letters(c())
    fouten(0)
    spel_klaar(FALSE)
    laatste_gok(NULL)
    win_frame(0)
    dood_frame(0)
  })

  raad_letter <- function(letter) {
    if (woord() == "") return()
    if (spel_klaar()) return()
    if (letter %in% fout_letters()) return()
    if (letter %in% patroon()) return()

    posities <- check_letter(letter, woord())

    if (length(posities) > 0) {
      patroon(update_patroon(patroon(), posities, letter))
      laatste_gok("goed")
    } else {
      fouten(fouten() + 1)
      fout_letters(c(fout_letters(), letter))
      laatste_gok("fout")
    }

    if (is_gewonnen(patroon())) {
      spel_klaar(TRUE)
      session$sendCustomMessage("confetti_win", list())
    } else if (fouten() >= 6) {
      spel_klaar(TRUE)
    }
  }

  lapply(alle_letters, function(lt) {
    observeEvent(input[[paste0("knop_", lt)]], {
      raad_letter(lt)
    }, ignoreInit = TRUE)
  })

  observeEvent(laatste_gok(), {
    req(!is.null(laatste_gok()))
    later::later(function() {
      laatste_gok(NULL)
    }, delay = 0.5)
  })

  output$patroon_tekst <- renderText({
    if (woord() == "") "Druk op Nieuw spel!"
    else toon_patroon(patroon())
  })

  output$debug_woord <- renderText({
    if (woord() == "") return("")
    paste("Woord (test):", woord())
  })

  output$gewonnen_tekst <- renderText({
    if (spel_klaar() && is_gewonnen(patroon())) "Gefeliciteerd! Je hebt gewonnen!"
    else ""
  })

  output$verloren_tekst <- renderText({
    if (spel_klaar() && !is_gewonnen(patroon())) paste("Helaas! Het woord was:", woord())
    else ""
  })

  output$toetsenbord <- renderUI({

    rij1 <- c("q","w","e","r","t","y","u","i","o","p")
    rij2 <- c("a","s","d","f","g","h","j","k","l")
    rij3 <- c("z","x","c","v","b","n","m")

    maak_rij <- function(letters) {
      knoppen <- lapply(letters, function(lt) {
        if (lt %in% fout_letters()) {
          kleur <- "background-color: red; color: white;"
        } else if (lt %in% patroon()) {
          kleur <- "background-color: lightgreen; color: black;"
        } else {
          kleur <- "background-color: lightgrey; color: black;"
        }
        actionButton(
          inputId = paste0("knop_", lt),
          label   = toupper(lt),
          style   = paste("width: 38px; height: 38px; margin: 2px; padding: 0; font-weight: bold;", kleur)
        )
      })
      div(style = "text-align: center; margin-bottom: 4px;",
          do.call(tagList, knoppen))
    }

    tagList(
      maak_rij(rij1),
      maak_rij(rij2),
      maak_rij(rij3)
    )
  })

  output$galg <- renderPlot({

    wf <- win_frame()   
    df <- dood_frame()   

    gewonnen <- spel_klaar() && is_gewonnen(patroon())
    verloren <- spel_klaar() && !is_gewonnen(patroon())

    gok <- laatste_gok()
    kleur <- if (gewonnen) "#FFD700"
             else if (verloren) "black"
             else if (is.null(gok)) "black"
             else if (gok == "goed") "lightgreen"
             else "red"

    par(mar = c(0, 0, 0, 0))
    plot(0, 0, type = "n",
         xlim = c(0, 10), ylim = c(0, 10),
         axes = FALSE, xlab = "", ylab = "",
         asp = 1)

    n <- fouten()
    t <- seq(0, 2*pi, length.out = 100)

    #Galg
    lines(c(1, 9),   c(1, 1),     lwd = 4, col = kleur)
    lines(c(2, 2),   c(1, 9.5),   lwd = 4, col = kleur)
    lines(c(2, 6),   c(9.5, 9.5), lwd = 4, col = kleur)
    lines(c(6, 6),   c(9.5, 8.8), lwd = 2, col = kleur)
    lines(c(2, 4),   c(3, 1),     lwd = 3, col = kleur)
    lines(c(2, 4),   c(7.5, 9.5), lwd = 3, col = kleur)

   
    if (gewonnen) {
      # ── DANS-ANIMATIE ──────────────────────────────────────────────────

      bob  <- 0.18 * sin(wf * pi / 8)   # op-neer beweging
      cx   <- 6
      cy   <- 8.1 + bob

      # Geel gevuld hoofd
      polygon(cx + 0.65*cos(t), cy + 0.65*sin(t),
              border = "#FFD700", col = "#FFE566", lwd = 2)

      # Ogen (knipperen elke ~2 seconden)
      if ((wf %% 16) %in% c(6, 14)) {
        segments(cx-0.30, cy+0.22, cx-0.12, cy+0.22, lwd=2, col="black")
        segments(cx+0.12, cy+0.22, cx+0.30, cy+0.22, lwd=2, col="black")
      } else {
        points(cx-0.21, cy+0.22, pch=19, cex=1.3, col="black")
        points(cx+0.21, cy+0.22, pch=19, cex=1.3, col="black")
      }

      # Glimlach
      smt <- seq(pi+0.45, 2*pi-0.45, length.out=40)
      lines(cx + 0.38*cos(smt), cy + 0.38*sin(smt), lwd=2.5, col="black")

      # Lichaam
      lines(c(cx, cx), c(cy-0.65, cy-2.3+bob), lwd=2.5, col="#FFD700")

      # Armen: links en rechts wisselen omhoog/omlaag
      swing <- sin(wf * pi / 8)
      lines(c(cx, cx - 1.5 - swing*0.3), c(cy-1.05, cy-1.05 + swing*1.1), lwd=2.5, col="#FFD700")
      lines(c(cx, cx + 1.5 + swing*0.3), c(cy-1.05, cy-1.05 - swing*1.1), lwd=2.5, col="#FFD700")

      # Benen: scharen heen en weer
      lines(c(cx, cx - 0.9 + swing*0.7), c(cy-2.3, cy-3.8+bob), lwd=2.5, col="#FFD700")
      lines(c(cx, cx + 0.9 - swing*0.7), c(cy-2.3, cy-3.8+bob), lwd=2.5, col="#FFD700")

      # Roterende gekleurde sterren
      kleuren <- c("#FF4444","#FF9900","#33CC33","#3399FF","#CC44FF","#FF66CC")
      for (i in 1:6) {
        hoek <- (i-1) * 2*pi/6 + wf * pi/16
        sx <- cx + 2.8*cos(hoek)
        sy <- (cy-1) + 2.8*sin(hoek)
        if (sx > 0.3 && sx < 9.7 && sy > 0.3 && sy < 9.7)
          points(sx, sy, pch=8, cex=2.5, col=kleuren[i], lwd=2)
      }

      text(5, 0.45, "Gewonnen!", col="#FFD700", cex=2.2, font=2)

    # ══════════════════════════════════════════════════════════════════════
    } else if (verloren) {
      # ── DOOD-ANIMATIE ──────────────────────────────────────────────────
      #
      # df = 0..12  : poppetje + ton zichtbaar
      # df = 13..23 : ton glijdt naar rechts weg
      # df = 24..32 : poppetje zakt omlaag
      # df = 33+    : lijk hangt – X-ogen, tong, bloed

      blok_p <- if (df < 13) 0 else min((df-13)/10, 1)   # ton-schuif voortgang
      val_p  <- if (df < 24) 0 else min((df-24)/8,  1)   # val voortgang
      drop   <- val_p * 0.5                               # max 0.5 eenheden
      is_dood <- df >= 33
      bloed_p <- if (df < 38) 0 else min((df-38)/25, 1)

      # Ton
      if (blok_p < 1) {
        bx <- 6 + blok_p * 9    
        rect(bx-1.5, 3.5, bx+1.5, 4.25, col="#A0522D", border="#5D2E0C", lwd=2)
        segments(bx-0.5, 3.5, bx-0.5, 4.25, lwd=1, col="#5D2E0C")
        segments(bx+0.5, 3.5, bx+0.5, 4.25, lwd=1, col="#5D2E0C")
        segments(bx-1.5, 3.75, bx+1.5, 3.75, lwd=0.8, col="#5D2E0C")
        segments(bx-1.5, 4.00, bx+1.5, 4.00, lwd=0.8, col="#5D2E0C")
      }

      # Nekkoord (van touwuiteinde naar bovenkant hoofd)
      cx   <- 6
      cy_h <- 8.1 - drop
      lines(c(6, cx), c(8.8, cy_h+0.65), lwd=2, col="black")

      # Hoofd
      if (is_dood) {
        polygon(cx + 0.65*cos(t), cy_h + 0.65*sin(t),
                border="black", col="#D4C08A", lwd=2)
        # X-ogen
        for (s in c(-1, 1)) {
          ex <- cx + s*0.22
          segments(ex-0.13, cy_h+0.30, ex+0.13, cy_h+0.10, lwd=2.5, col="black")
          segments(ex-0.13, cy_h+0.10, ex+0.13, cy_h+0.30, lwd=2.5, col="black")
        }
        # Tong
        tong_t <- seq(0, pi, length.out=20)
        polygon(cx + 0.14*cos(tong_t), (cy_h-0.48) - 0.20*sin(tong_t),
                col="#EE4444", border="#BB0000")
      } else {
        lines(cx + 0.65*cos(t), cy_h + 0.65*sin(t), lwd=2, col="black")
      }

      # Lichaam
      body_bot <- 5.8 - drop
      lines(c(cx, cx), c(cy_h-0.65, body_bot), lwd=2, col="black")

      # Armen
      arm_y <- 7.0 - drop
      if (is_dood) {
        lines(c(cx, cx-0.7), c(arm_y, arm_y-1.7), lwd=2, col="black")
        lines(c(cx, cx+0.7), c(arm_y, arm_y-1.7), lwd=2, col="black")
      } else {
        lines(c(cx, 4.4), c(arm_y, 5.8-drop), lwd=2, col="black")
        lines(c(cx, 7.6), c(arm_y, 5.8-drop), lwd=2, col="black")
      }

      # Benen
      if (is_dood) {
        lines(c(cx, cx-0.55), c(body_bot, body_bot-1.9), lwd=2, col="black")
        lines(c(cx, cx+0.55), c(body_bot, body_bot-1.9), lwd=2, col="black")
      } else {
        lines(c(cx, 4.6), c(body_bot, 4.2-drop*0.5), lwd=2, col="black")
        lines(c(cx, 7.4), c(body_bot, 4.2-drop*0.5), lwd=2, col="black")
      }

      # Bloed
      if (bloed_p > 0) {
        voet_y <- body_bot - 1.9
        lines(c(cx-0.55, cx-0.55), c(voet_y, voet_y - bloed_p*2.0), lwd=3, col="#CC0000")
        points(cx-0.55, voet_y - bloed_p*2.0, pch=19, cex=1.6, col="#CC0000")
        if (bloed_p > 0.3) {
          d2 <- (bloed_p-0.3)/0.7 * 1.5
          lines(c(cx+0.55, cx+0.55), c(voet_y+0.1, voet_y+0.1-d2), lwd=2.5, col="#AA0000")
          points(cx+0.55, voet_y+0.1-d2, pch=19, cex=1.3, col="#AA0000")
        }
        if (bloed_p > 0.6) {
          plas_r <- (bloed_p-0.6)/0.4 * 0.9
          polygon(cx + plas_r*cos(t), 1.15 + plas_r*0.3*sin(t), col="#880000", border=NA)
        }
      }

      if (is_dood) text(5, 0.5, "Verloren...", col="#880000", cex=1.8, font=2)

    # ══════════════════════════════════════════════════════════════════════
    } else {
      # ── Normaal spel ───────────────────────────────────────────────────
      if (n >= 1) lines(6 + 0.65*cos(t), 8.1 + 0.65*sin(t), lwd=2, col=kleur)
      if (n >= 2) lines(c(6, 6),   c(7.45, 5.8), lwd=2, col=kleur)
      if (n >= 3) lines(c(6, 4.4), c(7.0,  5.8), lwd=2, col=kleur)
      if (n >= 4) lines(c(6, 7.6), c(7.0,  5.8), lwd=2, col=kleur)
      if (n >= 5) lines(c(6, 4.6), c(5.8,  4.2), lwd=2, col=kleur)
      if (n >= 6) lines(c(6, 7.4), c(5.8,  4.2), lwd=2, col=kleur)
    }

  }, bg = "white", width = 480, height = 480)
}

shinyApp(ui, server)
